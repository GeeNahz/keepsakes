# Copy to `.env` (gitignored) and fill in. Real environment variables
# always override values from `.env`. Empty values count as unset.

# --- Database (dev/test) --------------------------------------------------
DB_USER=postgres
DB_PASS=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Database (prod/staging) ----------------------------------------------
# DATABASE_URL=ecto://USER:PASS@postgres/keepsakes_prod
# POOL_SIZE=10
# ECTO_IPV6=false

# --- Web ------------------------------------------------------------------
PORT=4000
# PHX_HOST=keepsake.example.com
# PHX_SERVER=true
# Generate with: mix phx.gen.secret
# SECRET_KEY_BASE=

# --- Encryption at rest (required in prod) --------------------------------
# 32 random bytes, base64. Generate with:
#   mix run --no-start -e 'IO.puts Base.encode64(:crypto.strong_rand_bytes(32))'
# Never change it once data is encrypted (rotate via a second cipher instead).
CLOAK_KEY=

# --- Photo storage --------------------------------------------------------
# Leave S3_BUCKET empty to store photos on local disk (LOCAL_UPLOADS_DIR,
# defaults to priv/uploads in dev and /var/lib/keepsakes/uploads in prod).
# Cloudflare R2: S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto
# DO Spaces:     S3_ENDPOINT=https://<region>.digitaloceanspaces.com,   S3_REGION=<region>
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LOCAL_UPLOADS_DIR=
# Local disk behind OpenResty only: internal location that serves
# LOCAL_UPLOADS_DIR (e.g. /_media). Empty = the app sends files itself.
LOCAL_X_ACCEL_PREFIX=
# Place names from photo GPS via OpenStreetMap Nominatim: "nominatim"
# (default) or "none". See docs/setup/accounts.md.
GEOCODER=

# --- Email (Resend) -------------------------------------------------------
# MAIL_DELIVERY: "resend" or "local". Defaults to resend in prod and local
# in dev (emails show at /dev/mailbox). Set to resend in dev to send real mail.
MAIL_DELIVERY=
# Send-only API key from resend.com -> API Keys (required when delivering via Resend)
RESEND_API_KEY=
# Must be on your Resend-verified domain, e.g. hello@yourdomain.com
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Keepsake

# --- Payments (Flutterwave v3) --------------------------------------------
# Dashboard -> Settings -> API keys. Use Test mode keys in dev and staging,
# Live keys only in production.
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=
# Any long random string; paste the same value in Dashboard -> Settings ->
# Webhooks -> Secret hash. Webhooks without it are rejected.
FLW_SECRET_HASH=
