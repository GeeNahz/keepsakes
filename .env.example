# Copy to `.env` (gitignored) and fill in. Real environment variables
# always override values from `.env`. Empty values count as unset.

# --- Database (dev/test) --------------------------------------------------
DB_USER=postgres
DB_PASS=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Database (prod/staging) ----------------------------------------------
# DATABASE_URL=ecto://USER:PASS@postgres/keepsakes_prod
# POOL_SIZE=10
# ECTO_IPV6=false

# --- Web ------------------------------------------------------------------
PORT=4000
# Dev only: set to 0.0.0.0 when using the local OpenResty stack (compose.yaml)
# so the container can reach the dev server. Unset = loopback only.
# PHX_BIND_IP=
# PHX_HOST=keepsake.example.com
# PHX_SERVER=true
# Generate with: mix phx.gen.secret
# SECRET_KEY_BASE=

# --- Encryption at rest (required in prod) --------------------------------
# 32 random bytes, base64. Generate with:
#   mix run --no-start -e 'IO.puts Base.encode64(:crypto.strong_rand_bytes(32))'
# Never change it once data is encrypted (rotate via a second cipher instead).
CLOAK_KEY=

# --- Photo storage --------------------------------------------------------
# Leave S3_BUCKET empty to store photos on local disk (LOCAL_UPLOADS_DIR,
# defaults to priv/uploads in dev and /var/lib/keepsakes/uploads in prod).
# Cloudflare R2: S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto
# DO Spaces:     S3_ENDPOINT=https://<region>.digitaloceanspaces.com,   S3_REGION=<region>
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LOCAL_UPLOADS_DIR=
# Local disk behind OpenResty only: internal location that serves
# LOCAL_UPLOADS_DIR (e.g. /_media). Empty = the app sends files itself.
LOCAL_X_ACCEL_PREFIX=
# Place names from photo GPS via OpenStreetMap Nominatim: "nominatim"
# (default) or "none". See docs/setup/accounts.md.
GEOCODER=

# --- Email (Resend) -------------------------------------------------------
# MAIL_DELIVERY: "resend" or "local". Defaults to resend in prod and local
# in dev (emails show at /dev/mailbox). Set to resend in dev to send real mail.
MAIL_DELIVERY=
# Send-only API key from resend.com -> API Keys (required when delivering via Resend)
RESEND_API_KEY=
# Must be on your Resend-verified domain, e.g. hello@yourdomain.com
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Keepsake
# New support tickets and customer replies are emailed here until the admin
# portal exists, e.g. support@yourdomain.com. Empty = no emails.
SUPPORT_INBOX=

# --- Admin portal ---------------------------------------------------------
# Served only at this host; must start with "admin.". Default:
# admin.<PHX_HOST> (admin.localhost in dev).
# ADMIN_HOST=
# true: staff must set up two-step login before getting in. Optional in
# dev; always true on the server (deploy/server/env/*.env.example).
REQUIRE_STAFF_TWO_STEP=
# This account is made Super Admin at startup (and when it signs up). Without
# it, run: mix keepsakes.staff.grant you@example.com --role super_admin
SUPER_ADMIN_EMAIL=

# --- Custom domains (production) -------------------------------------------
# Customers CNAME their domain to EDGE_HOST (default edge.<PHX_HOST>); root
# domains use A records to EDGE_IPS (your server's public IPs, comma-separated).
# EDGE_HOST=
# EDGE_IPS=
# Optional secret OpenResty sends when asking whether to issue a certificate.
# Read by both the app and the openresty service (compose passes it on), so
# one value here covers both. Generate with: openssl rand -hex 32
# TLS_ASK_TOKEN=

# --- Edge certificates (openresty service) --------------------------------
# Set on the openresty service, not the app. Locally compose.yaml points at
# Pebble (https://pebble:14000/dir). Production: leave ACME_DIRECTORY_URL
# unset for Let's Encrypt, or use its staging CA while testing:
#   https://acme-staging-v02.api.letsencrypt.org/directory
# ACME_EMAIL gets Let's Encrypt's expiry and policy notices.
# ACME_DIRECTORY_URL=
# ACME_EMAIL=
# Renew certificates with fewer than this many days left (default 30), and
# how often to check, in seconds (default 21600 = 6 h).
# ACME_RENEW_DAYS=30
# ACME_RENEW_CHECK_SECONDS=21600
# At most this many brand-new certificates per minute / per hour (renewals
# don't count), to stay inside Let's Encrypt's 300 new orders per 3 hours.
# ACME_NEW_PER_MINUTE=10
# ACME_NEW_PER_HOUR=90
# Which app each hostname goes to (host:port on the Docker network). Local
# default: the dev server, app:4100. On the server (deploy/server/):
# app-production:4000, with staging's own hostnames (space-separated)
# going to STAGING_UPSTREAM instead.
# APP_UPSTREAM=app:4100
# STAGING_HOSTS=
# STAGING_UPSTREAM=app-staging:4000
# How long OpenResty waits for the app's certificate answer (default 2000).
# compose.yaml sets 10000 for the slow dev server; leave unset in production.
# TLS_ASK_TIMEOUT_MS=2000

# --- Metrics (prod/staging) ---------------------------------------------------
# Prometheus metrics (Keepsakes.PromEx) on their own port, reachable only on
# the server's Docker network; read by the optional metrics profile
# (DEPLOYMENT.md, "Monitoring"). Never on in dev or tests. Default in
# production: on, port 4021.
# METRICS_ENABLED=true
# METRICS_PORT=4021

# --- Payments (Flutterwave v3) --------------------------------------------
# Dashboard -> Settings -> API keys. Use Test mode keys in dev and staging,
# Live keys only in production.
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=
# Any long random string; paste the same value in Dashboard -> Settings ->
# Webhooks -> Secret hash. Webhooks without it are rejected.
FLW_SECRET_HASH=
