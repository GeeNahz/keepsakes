# Production app settings. On the server: /srv/keepsakes/production/.env,
# chmod 600, never committed. Every variable is explained in the repo's
# .env.example; this lists what production needs.

# --- Database: the keepsakes_prod login from infra/.env ---------------------
DATABASE_URL=ecto://keepsakes_prod:CHANGE_ME_PRODUCTION_DB_PASSWORD@postgres/keepsakes_prod
POOL_SIZE=10

# --- Web ---------------------------------------------------------------------
PHX_HOST=keepsake.example.com
# mix phx.gen.secret
SECRET_KEY_BASE=
# 32 random bytes, base64. NEVER change once data exists; keep a copy in
# your password manager (backups can't be read back without it)
CLOAK_KEY=

# --- Admin portal (admin.<PHX_HOST>) -----------------------------------------
REQUIRE_STAFF_TWO_STEP=true
SUPER_ADMIN_EMAIL=

# --- Custom domains ----------------------------------------------------------
# EDGE_HOST defaults to edge.<PHX_HOST>
EDGE_IPS=
# openssl rand -hex 32; the same value in infra/.env and staging/.env
TLS_ASK_TOKEN=

# --- Photos: the production R2 bucket ----------------------------------------
S3_BUCKET=keepsakes-media
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email (Resend) ----------------------------------------------------------
MAIL_DELIVERY=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=hello@keepsake.example.com
MAIL_FROM_NAME=Keepsake
SUPPORT_INBOX=support@keepsake.example.com

# --- Payments: Flutterwave LIVE keys ------------------------------------------
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=
FLW_SECRET_HASH=

# --- Metrics (port 4021, Docker network only) --------------------------------
METRICS_ENABLED=true
