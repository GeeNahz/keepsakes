# Shared services: the edge, Postgres, backups, metrics. On the server:
# /srv/keepsakes/infra/.env, chmod 600, never committed.

# --- Edge ------------------------------------------------------------------
# Hostnames served by staging (everything else goes to production).
# Add any test customer domain you point at staging.
STAGING_HOSTS=staging.keepsake.example.com admin.staging.keepsake.example.com
# Where every other hostname goes. A server that only runs staging:
# app-staging:4000 (and STAGING_HOSTS empty)
# APP_UPSTREAM=app-production:4000
# Let's Encrypt notices (expiry, policy changes) go here
ACME_EMAIL=you@example.com
# While testing: https://acme-staging-v02.api.letsencrypt.org/directory
# Then empty (= Let's Encrypt production); see DEPLOYMENT.md
ACME_DIRECTORY_URL=
# openssl rand -hex 32; the same value as both apps' TLS_ASK_TOKEN
TLS_ASK_TOKEN=

# --- Postgres ----------------------------------------------------------------
# The superuser (backups and maintenance only; the apps never use it)
POSTGRES_PASSWORD=
# Each app's own login, made when the database volume is first created
# (postgres/init.sh). Copy each into that app's DATABASE_URL. Changing them
# later means ALTER ROLE as well. Use letters and digits only (they go in a URL):
#   openssl rand -hex 24
PRODUCTION_DB_PASSWORD=
# Empty = no database for that environment on this server
STAGING_DB_PASSWORD=
# For a 4 GB droplet: 512MB and 1536MB
# PG_SHARED_BUFFERS=256MB
# PG_EFFECTIVE_CACHE_SIZE=768MB

# --- Backups -------------------------------------------------------------------
# Databases to dump, as env=database
BACKUP_DATABASES=production=keepsakes_prod staging=keepsakes_staging
# Media buckets to copy into the backup bucket, as env=bucket
MEDIA_BUCKETS=production=keepsakes-media
# Nightly, UTC
BACKUP_AT=02:30
BACKUP_BUCKET=keepsakes-backups
# An R2 token that can read the media buckets and write the backup bucket
BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# The age PUBLIC key (age1...). The private key stays off this server.
AGE_RECIPIENT=
# Optional: a healthchecks.io ping URL; you're alerted when a night's
# backup doesn't arrive (or reports /fail)
BACKUP_PING_URL=

# --- Metrics profile (bin/metrics on) ------------------------------------------
GRAFANA_ADMIN_PASSWORD=
