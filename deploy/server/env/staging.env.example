# Staging app settings. On the server: /srv/keepsakes/staging/.env,
# chmod 600, never committed. Same as production except where noted:
# its own database, bucket and secrets, and TEST payment keys.

# --- Database: the keepsakes_staging login from infra/.env ------------------
DATABASE_URL=ecto://keepsakes_staging:CHANGE_ME_STAGING_DB_PASSWORD@postgres/keepsakes_staging
POOL_SIZE=5

# --- Web ---------------------------------------------------------------------
# The admin portal is then admin.staging.<domain> (needs its own DNS record)
PHX_HOST=staging.keepsake.example.com
# Its own values, never production's
SECRET_KEY_BASE=
CLOAK_KEY=

# --- Admin portal ------------------------------------------------------------
REQUIRE_STAFF_TWO_STEP=true
SUPER_ADMIN_EMAIL=

# --- Custom domains ----------------------------------------------------------
# Test customer domains for staging must also be listed in infra/.env
# STAGING_HOSTS, or the edge sends them to production
EDGE_IPS=
TLS_ASK_TOKEN=

# --- Photos: the staging bucket ----------------------------------------------
S3_BUCKET=keepsakes-media-staging
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email (Resend) ----------------------------------------------------------
MAIL_DELIVERY=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=hello@keepsake.example.com
MAIL_FROM_NAME=Keepsake (staging)
SUPPORT_INBOX=

# --- Payments: Flutterwave TEST keys ------------------------------------------
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=
FLW_SECRET_HASH=

# --- Metrics -------------------------------------------------------------------
METRICS_ENABLED=true
