#!/usr/bin/env bash
# Starts or updates the shared services (edge, Postgres, backups):
#
#   bin/infra-up <tag>
#
# Run by production deploys before the app, and by hand the first time.
# Only containers whose image or settings changed are recreated. An edge
# change restarts OpenResty: a few seconds without the site, so it's left
# to production deploys (staging deploys never touch the shared services).
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

tag="${1:-}"
valid_tag "$tag"
export INFRA_TAG="$tag"

# Pull only what's missing (tags never change; see bin/deploy), so running
# this by hand works while the server is logged out of GHCR
if [ "${SKIP_PULL:-}" != "1" ] &&
  ! { has_image "$KS_REGISTRY/keepsakes-edge:$tag" && has_image "$KS_REGISTRY/keepsakes-backup:$tag"; }; then
  say "infra: pulling the edge and backup images ($tag)"
  infra pull --quiet openresty backup
fi

say "infra: starting"
infra up -d --wait --quiet-pull --remove-orphans
echo "$tag" >"$KS_ROOT/infra/.deployed"
say "infra: $tag is running"
