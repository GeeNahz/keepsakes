<!DOCTYPE html>
<%!-- Guest pages (access code, timeline, slideshow): always the night theme,
     no theme switcher, and never indexed by search engines. --%>
<html lang="en" data-theme="keepsake-night">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="same-origin" />
    <meta name="color-scheme" content="dark" />
    <.live_title default="Keepsake" suffix=" · Keepsake" phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-ks-night text-white antialiased">
    {@inner_content}
  </body>
</html>
