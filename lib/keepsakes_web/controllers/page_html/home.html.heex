<%!-- Interim home page; the full landing page arrives in Stage 10 --%>
<Layouts.app flash={@flash} current_scope={@current_scope} shell={:plain}>
  <section id="home-hero" class="flex flex-col items-start gap-6 py-16">
    <h1 class="max-w-2xl text-5xl font-bold leading-[1.05]">
      Every memory, in the order it happened.
    </h1>
    <p class="max-w-xl text-lg text-ks-muted">
      Albums become a timeline your family can open with a link and a private code.
      Start with a 2-month free trial. No card needed.
    </p>
    <div class="flex flex-wrap gap-2.5">
      <.button id="home-register" variant="primary" size="lg" navigate={~p"/users/register"}>
        Create your account
      </.button>
      <.button id="home-log-in" size="lg" navigate={~p"/users/log-in"}>Log in</.button>
    </div>
  </section>
</Layouts.app>
