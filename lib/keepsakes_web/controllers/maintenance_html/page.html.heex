<!DOCTYPE html>
<html lang="en" data-theme="keepsake">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Back shortly · Keepsake</title>
    <link rel="stylesheet" href={~p"/assets/css/app.css"} />
  </head>
  <body class="bg-base-200">
    <main
      id="maintenance"
      class="flex min-h-screen flex-col items-center justify-center gap-6 px-4 text-center"
    >
      <.logo size={32} wordmark_class="text-[22px]" />
      <div class="flex max-w-md flex-col gap-2">
        <h1 class="font-display text-3xl font-bold">Back shortly</h1>
        <p class="text-[17px] text-ks-muted">{@message}</p>
      </div>
      <p class="text-sm text-ks-muted">Your albums and photos are safe.</p>
    </main>
  </body>
</html>
