<Layouts.app flash={@flash} shell={:admin}>
  <div class="flex flex-col gap-6">
    <div class="flex flex-col gap-1.5">
      <h1 class="text-2xl font-bold">Set up two-step login</h1>
      <p class="text-ks-muted">
        Staff need it to sign in. It's turned on for your Keepsake account too,
        so you'll use the same app on the main site.
      </p>
    </div>

    <ol class="flex flex-col gap-4 text-[15px]">
      <li class="flex flex-col gap-3">
        <span>1. Scan this with an authenticator app (Google Authenticator, 1Password, Authy…).</span>
        <div
          id="staff-totp-qr"
          class="mx-auto w-48 rounded-field border border-base-300 bg-white p-2 [&_svg]:h-auto [&_svg]:w-full"
        >
          {Phoenix.HTML.raw(@qr)}
        </div>
        <p class="text-sm text-ks-muted">
          Can't scan? Enter this key:
          <code id="staff-totp-key" class="font-mono text-base-content">{@key}</code>
        </p>
      </li>
      <li>2. Enter the 6-digit code it shows.</li>
    </ol>

    <.form
      for={%{}}
      id="staff-setup-form"
      action={~p"/two-step/setup"}
      class="flex flex-col gap-3"
    >
      <input
        id="staff-setup-code"
        name="code"
        type="text"
        inputmode="numeric"
        autocomplete="one-time-code"
        aria-label="Code"
        required
        placeholder="123 456"
        class="input h-14 w-full border-ks-field bg-base-100 text-center font-mono text-2xl tracking-[0.3em]"
      />
      <p :if={@error} id="staff-setup-error" class="text-sm text-error">{@error}</p>
      <.button variant="primary" size="lg" class="w-full">Turn on</.button>
    </.form>
  </div>
</Layouts.app>
